# ============================================
# LLM Configuration
# ============================================

# General LLM Settings
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your-gemini-api-key
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta

# Embedding Settings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIM=768

# ============================================
# Provider-Specific Settings (Choose one)
# ============================================

# --- DeepSeek ---
# DeepSeek dùng API tương thích OpenAI qua LLM_API_URL
# LLM_API_KEY=your-deepseek-api-key

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# --- Google Gemini ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-key

# --- Ollama (Local) ---
# OLLAMA_HOST=http://localhost:11434
# FAST_INTENT_MODEL=qwen2.5:7b-instruct

# ============================================
# RAG Configuration - Storage Architecture
# PostgreSQL + Qdrant + Redis
# ============================================

RAG_WORKING_DIR=./rag_storage
RAG_WORKSPACE=default

# ========== PostgreSQL (Raw Data) ==========
# Stores: chunks, entities, relations, document status
KV_STORAGE=PGKVStorage
GRAPH_STORAGE=PGGraphStorage
DOC_STATUS_STORAGE=PGDocStatusStorage

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=noble_rag

# ========== Qdrant (Vector Data) ==========
# Optimized vector database for semantic search
VECTOR_STORAGE=QdrantVectorDBStorage

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=noble_rag_vectors
# QDRANT_API_KEY=optional-api-key

# ========== Redis (Session Cache) ==========
# Fast in-memory store for conversation sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=optional-password
REDIS_SESSION_TTL=86400  # 1 day in seconds

# ============================================
# RAG Chunk & Query Settings
# ============================================

CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100

TOP_K=60
MAX_ASYNC=4

# ============================================
# Application Configuration
# ============================================

APP_NAME=Noble_RAG
APP_VERSION=1.0.0
DEBUG=false

# Whisper Service
WHISPER_HOST=localhost
WHISPER_PORT=8000
