FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies (dùng chung requirements của RAG service)
COPY service/RAG/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir streamlit>=1.35

# Copy UI code
COPY ui/ /app/ui/

# Copy client library (nếu có helper gọi RAG service)
COPY client/ /app/client/

# Copy scripts
COPY scripts/ /app/scripts/

ENV PYTHONPATH=/app
ENV LLM_PROVIDER=openai
ENV WEB_UI_HOST=0.0.0.0
ENV WEB_UI_PORT=8501

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["python", "-m", "streamlit", "run", "ui/rag_web_ui.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true"]
