RETRIEVAL_TIMEOUT_SEC=15

ORCHESTRATOR_DECIDER_ENABLED=true
ORCHESTRATOR_DECIDER_API_FORMAT=openai
ORCHESTRATOR_DECIDER_API_URL=https://api.moonshot.ai/v1/chat/completions
ORCHESTRATOR_DECIDER_API_KEY_HEADER=Authorization
