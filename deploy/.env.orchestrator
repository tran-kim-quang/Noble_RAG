ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8021
ORCHESTRATOR_DEFAULT_TOP_K=5

RETRIEVAL_SERVICE_URL=http://retrieval-service:8011
RETRIEVAL_TIMEOUT_SEC=15

ORCHESTRATOR_DECIDER_ENABLED=true
