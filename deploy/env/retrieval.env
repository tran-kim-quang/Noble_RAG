HOST=0.0.0.0
PORT=8011

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=retrieval_bench_qwen3_8b_local
QDRANT_TIMEOUT_SEC=10

EMBEDDING_BACKEND=remote
EMBEDDING_API_URL=http://host.docker.internal:11434/api/embeddings
EMBEDDING_API_FORMAT=ollama
EMBEDDING_API_TIMEOUT_SEC=20
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_HEADER=X-API-Key
EMBEDDING_API_AUTH_TOKEN=
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=4096

MODEL_WARM_ENABLED=true
MODEL_WARM_INTERVAL_SEC=120
MODEL_WARM_INITIAL_DELAY_SEC=15
EMBEDDING_WARM_TEXT=warmup retrieval embedding
LLM_WARM_ENABLED=true
LLM_WARM_API_URL=http://host.docker.internal:11434/api/generate
LLM_WARM_MODEL=gemma4:latest
LLM_WARM_PROMPT=warmup ping
LLM_WARM_TIMEOUT_SEC=20
LLM_WARM_KEEP_ALIVE=30m

DEFAULT_TOP_K=5
MAX_TOP_K=20
MIN_RETRIEVE_SCORE=0.68
LOW_CONFIDENCE_EMPTY_RESULTS=false
