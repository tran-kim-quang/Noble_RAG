ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8021
ORCHESTRATOR_DEFAULT_TOP_K=5

RETRIEVAL_SERVICE_URL=http://retrieval-service:8011
RETRIEVAL_TIMEOUT_SEC=15

ORCHESTRATOR_DECIDER_ENABLED=true
ORCHESTRATOR_DECIDER_API_FORMAT=ollama
ORCHESTRATOR_DECIDER_API_URL=http://ollama:11434/api/generate
ORCHESTRATOR_DECIDER_API_KEY_HEADER=Authorization
ORCHESTRATOR_DECIDER_API_KEY=
ORCHESTRATOR_DECIDER_MODEL=hermes3:3b
ORCHESTRATOR_DECIDER_TIMEOUT_SEC=45
ORCHESTRATOR_DECIDER_TEMPERATURE=0.2
ORCHESTRATOR_DECIDER_KEEP_ALIVE=30m

ORCHESTRATOR_SYNTHESIS_API_FORMAT=ollama
ORCHESTRATOR_SYNTHESIS_API_URL=http://ollama:11434/api/generate
ORCHESTRATOR_SYNTHESIS_API_KEY_HEADER=Authorization
ORCHESTRATOR_SYNTHESIS_API_KEY=
ORCHESTRATOR_SYNTHESIS_MODEL=hermes3:3b
ORCHESTRATOR_SYNTHESIS_TIMEOUT_SEC=20
ORCHESTRATOR_SYNTHESIS_TEMPERATURE=0.38
ORCHESTRATOR_SYNTHESIS_KEEP_ALIVE=30m

# ===== Synthesis Latency Optimization =====
# Enable semantic caching to avoid redundant API calls
ORCHESTRATOR_SYNTHESIS_CACHE_ENABLED=true
ORCHESTRATOR_SYNTHESIS_CACHE_MAX_ENTRIES=1000
ORCHESTRATOR_SYNTHESIS_CACHE_TTL_SECONDS=3600

# Enable response length constraint (helps Kimi respond faster)
ORCHESTRATOR_SYNTHESIS_OUTPUT_MAX_TOKENS=300

# Stream synthesis output from provider (lower perceived latency)
ORCHESTRATOR_SYNTHESIS_ENABLE_STREAMING=true

# Compression mode: disabled, moderate (recommended), or aggressive
ORCHESTRATOR_SYNTHESIS_COMPRESSION_MODE=aggressive

# Enable per-stage timing instrumentation for latency analysis
ORCHESTRATOR_ENABLE_TIMING_INSTRUMENTATION=true

# Optimized history depth for compressed mode (reduces prompt token count)
ORCHESTRATOR_SYNTHESIS_OPTIMIZED_HISTORY_TURNS=2

# Quick response lane for simple intents (greeting/basic consult)
ORCHESTRATOR_QUICK_INTENT_FAST_RESPONSE_ENABLED=true
ORCHESTRATOR_QUICK_INTENT_RESPONSE_MAX_WORDS=48

# Periodic model warmup (seconds)
ORCHESTRATOR_MODEL_WARMUP_ENABLED=true
ORCHESTRATOR_MODEL_WARMUP_INTERVAL_SEC=60
ORCHESTRATOR_MODEL_WARMUP_DECIDER_ENABLED=true
ORCHESTRATOR_MODEL_WARMUP_SYNTHESIS_ENABLED=false

LLM_DECIDER_API_FORMAT=
LLM_DECIDER_API_URL=
LLM_DECIDER_KEY=
LLM_DECIDER_NAME=

LANGFUSE_ENABLED=false
LANGFUSE_FLUSH_AT_REQUEST_END=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
