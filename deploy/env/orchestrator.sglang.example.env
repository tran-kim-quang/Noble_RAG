# SGLang profile for orchestrator-service
# Keep existing orchestrator.env unchanged; use this file when switching to SGLang.

ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8021
ORCHESTRATOR_DEFAULT_TOP_K=5

RETRIEVAL_SERVICE_URL=http://retrieval-service:8011
RETRIEVAL_TIMEOUT_SEC=15

ORCHESTRATOR_DECIDER_ENABLED=true
ORCHESTRATOR_DECIDER_API_URL=http://host.docker.internal:31000/api/generate
ORCHESTRATOR_DECIDER_MODEL=google/gemma-3-27b-it
ORCHESTRATOR_DECIDER_TIMEOUT_SEC=30
ORCHESTRATOR_DECIDER_TEMPERATURE=0.2
ORCHESTRATOR_DECIDER_KEEP_ALIVE=30m

LANGFUSE_ENABLED=false
LANGFUSE_FLUSH_AT_REQUEST_END=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
