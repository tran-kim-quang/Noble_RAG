ELEVENLABS_API_KEY=sk_71
ELEVENLABS_VOICE_ID=pGap
ELVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_MODEL_ID=eleven_v3
USE_ELEVENLABS_TTS=true
TTS_PROVIDER=elevenlabs
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_TIMEOUT_SEC=60
ELEVENLABS_MAX_RETRIES=3

# ElevenLabs API hard limit is 5000 chars per request.
# Cut at 4800 to leave a safe margin; sentence-boundary splitting
# ensures chunks end on a full stop so reading flow is preserved.
TTS_MAX_TEXT_CHARS=4800

NOBLE_RAG_CHAT_URL=http://127.0.0.1:8021/sales/query
NOBLE_RAG_LIVETALKING_QUERY_STREAM_URL=http://127.0.0.1:8021/integrations/livetalking/query-stream
NOBLE_RAG_LIVETALKING_START_URL=http://127.0.0.1:8021/integrations/livetalking/start
NOBLE_RAG_LIVETALKING_STOP_URL=http://127.0.0.1:8021/integrations/livetalking/stop
NOBLE_RAG_TIMEOUT_SEC=30
NOBLE_RAG_RETRIES=0
NOBLE_RAG_RETRY_DELAY_SEC=1

# LiveTalking GPU runtime defaults (one-process multi-GPU)
LIVETALKING_MULTI_GPU=true
LIVETALKING_GPU_IDS=0,1
